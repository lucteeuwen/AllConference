# Supabase project (Project Settings → API). Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Scraper only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:push` (Project Settings → Database).
SUPABASE_DB_PASSWORD=
# Scraper only, optional. YouTube Data API v3 key, to find games on schools'
# YouTube channels. Without it those games keep the link they had.
YOUTUBE_API_KEY=
